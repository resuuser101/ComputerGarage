# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Google reCAPTCHA v2
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your_recaptcha_site_key

# Resend Email Service
RESEND_API_KEY=your_resend_api_key
# Optional: custom sender (defaults to "Computer Garage <onboarding@resend.dev>")
# RESEND_FROM_EMAIL=your_verified_sender@domain.com

# Seller / Admin Invite Code (Optional)
# SELLER_INVITE_CODE=CYBERSEC-PROJECT

# Fallback Email Service (Nodemailer Gmail - Optional)
# GMAIL_USER=your_email@gmail.com
# GMAIL_APP_PASSWORD=your_gmail_app_password
